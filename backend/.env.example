# Copy this file to .env and fill in your own values.

# Local Postgres example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repochat
#
# Supabase example (from Project Settings -> Database -> Connection string -> URI):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repochat

# Max source files parsed per repo (keeps local runs fast/predictable)
MAX_FILES_PER_REPO=500

# Where repos get cloned to temporarily
CLONE_ROOT=/tmp/repo-chat-clones

# Frontend dev server origin (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Supabase API & Database Configuration
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_qgbdYDotVuQUSqypl2-gUA_G8INybfT
SUPABASE_API_KEY=your_supabase_secret_or_api_key_here
